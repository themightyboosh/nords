# ═══════════════════════════════════════════════════════════
# Nords Server — Multi-stage Dockerfile (pnpm workspace)
# Optimized for Cloud Run deployment
# ═══════════════════════════════════════════════════════════

# ── Stage 1: Build ──
FROM node:20-alpine AS builder
RUN corepack enable && corepack prepare pnpm@10 --activate
WORKDIR /app

# Copy workspace root files first (lockfile, workspace config)
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./

# Copy server package.json for dependency resolution
COPY server/package.json ./server/

# Copy client package.json (pnpm workspace needs all workspace members)
COPY client/package.json ./client/

# Install ALL dependencies (including devDependencies for tsc)
RUN pnpm install --frozen-lockfile

# Copy server source and compile TypeScript
COPY server/tsconfig.json ./server/
COPY server/src ./server/src
RUN pnpm --filter server run build

# ── Stage 2: Production ──
FROM node:20-alpine
RUN corepack enable && corepack prepare pnpm@10 --activate
WORKDIR /app

# Copy workspace root files
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY server/package.json ./server/
COPY client/package.json ./client/

# Install production dependencies only
RUN pnpm install --frozen-lockfile --prod && pnpm store prune

# Copy compiled output and migrations
COPY --from=builder /app/server/dist ./server/dist
COPY server/migrations ./server/migrations

WORKDIR /app/server

# Cloud Run sets PORT dynamically (default 8080)
EXPOSE 8080

# Health check for container orchestration
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD wget -qO- http://localhost:${PORT:-8080}/health || exit 1

CMD ["node", "dist/index.js"]
