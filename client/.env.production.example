# ═══════════════════════════════════════════════════════════
# Nords Client — Staging / Production Environment
# ═══════════════════════════════════════════════════════════
# Use this as a template for .env.staging or .env.production.
# Auth is REQUIRED — no bypass flags.

# ── Firebase ──
VITE_FIREBASE_API_KEY=your_production_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# ── API Config ──
VITE_API_URL=https://api.your-domain.com
VITE_WS_URL=wss://api.your-domain.com

# ── Feature Flags ──
# Auth is required on staging and production
VITE_SKIP_AUTH=false
VITE_SKIP_EMAIL_VERIFICATION=false
