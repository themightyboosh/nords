{
  "name": "server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npx tsx watch --env-file=.env src/index.ts",
    "build": "tsc",
    "start": "node dist/server/src/index.js",
    "db:proxy": "cloud-sql-proxy nords-spatial-1776012153:us-central1:nords-db-main --port=5433",
    "db:migrate": "node --loader ts-node/esm src/migrate.ts",
