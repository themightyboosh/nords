    "test:watch": "node --env-file=.env ./node_modules/.bin/vitest"
  },
  "dependencies": {
    "@google/genai": "^2.2.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "firebase-admin": "^13.8.0",
    "pg": "^8.11.3",
    "pg-format": "^1.0.4",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0",
    "zod": "^3.22.4",
    "@nords/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.11.0",
    "@types/pg-format": "^1.0.5",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "node-pg-migrate": "^7.1.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.3.3",
    "vitest": "^4.1.7"
  }
